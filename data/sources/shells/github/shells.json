{
  "$comment": "Shell availability per OS platform, sourced from GitHub Docs workflow-syntax.md. See: https://docs.github.com/en/actions/reference/workflows-and-actions/workflow-syntax.md",
  "shells": [
    {
      "name": "bash",
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "command": "bash --noprofile --norc -eo pipefail {0}"
    },
    {
      "name": "pwsh",
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "command": "pwsh -command \". '{0}'\""
    },
    {
      "name": "python",
      "platforms": [
        "linux",
        "macos",
        "windows"
      ],
      "command": "python {0}"
    },
    {
      "name": "sh",
      "platforms": [
        "linux",
        "macos"
      ],
      "command": "sh -e {0}"
    },
    {
      "name": "cmd",
      "platforms": [
        "windows"
      ],
      "command": "%ComSpec% /D /E:ON /V:OFF /S /C \"CALL \"{0}\"\""
    },
    {
      "name": "powershell",
      "platforms": [
        "windows"
      ],
      "command": "powershell -command \". '{0}'\""
    }
  ]
}
