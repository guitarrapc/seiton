      "maxDeprecatedMajorVersion": 3
    },
    {
      "actionRef": "actions/download-artifact@v8",
      "uses": "actions/download-artifact",
      "url": "https://raw.githubusercontent.com/actions/download-artifact/v8/action.yml",
      "rawFileName": "actions_download-artifact.action.yml",
      "maxDeprecatedMajorVersion": 3
    },
    {
      "actionRef": "actions/setup-dotnet@v5",
      "uses": "actions/setup-dotnet",
