{
  "schemaVersion": 1,
  "description": "Actions that can be replaced with built-in runner tooling. Each entry maps an action owner/repo to a suggested replacement command. The fetch pipeline verifies these repos are not archived before including them in the generated code.",
  "targets": [
    {
