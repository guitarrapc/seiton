    <PackageVersion Include="ConsoleAppFramework" Version="5.7.13" />
    <PackageVersion Include="TUnit" Version="1.76.28" />
    <PackageVersion Include="VYaml" Version="1.5.0" />
  </ItemGroup>
</Project>
